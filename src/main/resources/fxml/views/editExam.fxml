<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="pane" prefHeight="728.0" prefWidth="1200" stylesheets="@/css/views.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="at.ac.tuwien.lerntia.lerntia.ui.EditExamController">
    <styleClass>
        <String fx:value="view" />
    </styleClass>
    <TableView fx:id="questionTable" layoutX="16.0" layoutY="22.0" prefHeight="274.0" prefWidth="1155.0">
        <placeholder>
            <Label wrapText="true" text="Alle Fragen wurden der Prüfungstabelle hinzugefügt."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="questionColumn" prefWidth="390.0" text="Fragen" />
            <TableColumn fx:id="firstAnswerColumn" prefWidth="130.0" text="1. Antwort" />
            <TableColumn fx:id="secondAnswerColumn" prefWidth="130.0" text="2. Antwort" />
            <TableColumn fx:id="thirdAnswerColumn" prefWidth="130.0" text="3. Antwort" />
            <TableColumn fx:id="fourthAnswerColumn" prefWidth="130.0" text="4. Antwort" />
            <TableColumn fx:id="fifthAnswerColumn" prefWidth="130.0" text="5. Antwort" />
            <TableColumn fx:id="pictureColumn" editable="false" prefWidth="90.0" text="Bild" />
        </columns>
    </TableView>

    <Button fx:id="addQuestions" layoutX="376.0" layoutY="314.0" mnemonicParsing="false" onAction="#onAddQuestionsButtonClicked" stylesheets="@/css/arrow-button.css">
        <graphic>
            <ImageView fitHeight="30.0" fitWidth="50.0" layoutX="600.0" layoutY="320.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@/icons/down.png" />
            </ImageView>
        </graphic>
    </Button>
    <Button fx:id="removeQuestions" layoutX="753.0" layoutY="314.0" mnemonicParsing="false" onAction="#onRemoveQuestionsButtonClicked" stylesheets="@/css/arrow-button.css">
        <graphic>
            <ImageView fitHeight="30.0" fitWidth="50.0" layoutX="240.0" layoutY="320.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@/icons/up.png" />
            </ImageView>
        </graphic>
    </Button>

    <TableView fx:id="acceptedTable" layoutX="14.0" layoutY="374.0" prefHeight="274.0" prefWidth="1155.0">
        <placeholder>
            <Label wrapText="true" text="Es wurden noch keine Fragen der Prüfungstabelle hinzugefügt."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="columnAccepted" prefWidth="390.0" text="Prüfungsfragen" />
            <TableColumn prefWidth="130.0" text="1. Antwort" fx:id="xfirstAnswerColumn" />
            <TableColumn prefWidth="130.0" text="2. Antwort" fx:id="xsecondAnswerColumn" />
            <TableColumn prefWidth="130.0" text="3. Antwort" fx:id="xthirdAnswerColumn" />
            <TableColumn prefWidth="130.0" text="4. Antwort" fx:id="xfourthAnswerColumn" />
            <TableColumn prefWidth="130.0" text="5. Antwort" fx:id="xfifthAnswerColumn" />
            <TableColumn editable="false" prefWidth="90.0" text="Bild" fx:id="xpictureColumn" />
        </columns>
    </TableView>

    <Button fx:id="resetButton" layoutX="14.0" layoutY="666.0" mnemonicParsing="false" onAction="#onResetButtonClicked" pickOnBounds="false" prefHeight="41.0" prefWidth="188.0" text="Zurücksetzen" />

    <Button layoutX="764.0" layoutY="666.0" mnemonicParsing="false" onAction="#onRandomButtonClicked" pickOnBounds="false" prefHeight="41.0" prefWidth="188.0" text="Zufallsreihenfolge" />

    <Button layoutX="981.0" layoutY="666.0" mnemonicParsing="false" onAction="#onTableViewButtonClicked" prefHeight="41.0" prefWidth="188.0" text="Prüfung starten" />

</AnchorPane>
